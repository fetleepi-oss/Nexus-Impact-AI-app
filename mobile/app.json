{
  "expo": {
    "name": "Nexus Impact AI",
    "slug": "nexus-impact-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nexusimpact",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#070D1E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fetleepi.nexusimpact",
      "userInterfaceStyle": "dark"
    },
    "android": {
      "package": "com.fetleepi.nexusimpact",
      "userInterfaceStyle": "dark"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c3dfeca3-0898-48e1-9e93-358810033608"
      }
    },
    "owner": "fetlework"
  }
}
